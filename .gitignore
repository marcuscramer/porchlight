# Node
node_modules/
deploy/.env

# Rust workspace build output (pake-bridge, call-core)
/target/

# Android / Gradle
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/.kotlin/
android-app/local.properties
android-app/.idea/
android-app/captures/
*.iml

# Generated by Style Dictionary (tokens/config/android.config.mjs) — the
# Gradle build regenerates these automatically before every compile (see
# android-app/app/build.gradle.kts's styleDictionaryBuildAndroid task), the
# same "build output, not source" treatment as the Rust .so files above.
android-app/app/src/main/java/dev/porchlight/app/ui/theme/Dimens.kt
android-app/app/src/main/java/dev/porchlight/app/ui/theme/GeneratedColor.kt
android-app/app/src/main/java/dev/porchlight/app/ui/theme/GeneratedType.kt
android-app/app/src/main/java/dev/porchlight/app/ui/theme/GeneratedOpacity.kt

# Release signing — never commit keystores or signing secrets
*.keystore
*.jks

# Claude Code — local session/permission state, not shared project config
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS
.DS_Store
